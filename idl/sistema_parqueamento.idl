module ParqueamentoApp {

    struct UsuarioDTO {
        long id_usuario;
        string nome;
        string telefone;
        long tipo;
        // senha NÃO é incluída no DTO devolvido ao cliente,
        // por boas práticas de segurança (nunca devolvas a senha de volta)
    };


    struct ParqueDTO{
        long id_parque,
        string nome,
        string provincia,
        string localizacao,
        string telefone,
        string horario,
        string cobertura, //COBERTO ou NAO_COBERTO
        float precoHora,
        string fotoUrl

    }

        struct VagaDTO {
        long id_vaga;
        string numero_vaga;
        long estado;
        long id_parque;
        };


        struct ViaturaDTO{
            id_viatura,
            string marca,
            string modelo,
            string matricula,
            long id_usuario
        }

    struct ReservaDTO{
        long id_reserva,
        string data_entrada,
        string hora_entrada,
        string data_saida,
        string hora_saida,
        long id_vaga,
        long id_usuario,
        long id_viatura

    }

//Sequencia de elementos: Sintaxe: typedef sequence<ParqueEstacionamento> ParqueEstacionamentoSeq;
 //typedef sequence<UsuarioDTO> listaUsuarioDTO;
 typedef sequence<ParqueDTO> listaParqueDTO;
 typedef sequence<VagaDTO> listaVagaDTO;
 typedef sequence<ViaturaDTO> listaViaturaDTO;
typedef sequence<ReservaDTO> listaReservaDTO;



//Interfaces

    interface Usuario{
        // ==========================
        // USUÁRIO
        // ==========================


        UsuarioDTO login(
            in string telefone,
            in string senha
        );

        void cadastrar(
        in string nome,
        in string telefone,
        in string senha,
        in long tipo
        );

        UsuarioDTO actualizarDados(
        in long id_usuario,
        in string nome,
        in string telefone,
        in string senha  
        );

    };




    interface Parque{
        
        // ==========================
        // PARQUES
        // ==========================

        void adicionarParque(
        in string nome,
        in string provincia,
        in string localizacao,
        in string telefone,
        in string horario,
        in string cobertura, //COBERTO ou NAO_COBERTO
        in float precoHora,
        in string fotoUrl
        );


        void editarParque(
        in long id_parque
        in string nome,
        in string provincia,
        in string localizacao,
        in string telefone,
        in string horario,
        in string cobertura, //COBERTO ou NAO_COBERTO
        in float precoHora,
        in string fotoUrl
        );


        void removerParque(
            in long id_parque
        );


        listaParqueDTO pesquisarPorCategoria(
            in string categoria
        ); //Categoria pode ser província, nome ou preço. 


    };


    interface Vaga{

        // ==========================
        // VAGAS
        // ==========================

        void adicionarVaga(
            in long id_parque,
            in long numero_vagas // O numero de vagas que queres adicionar ao parque. Por exemplo 50, 100, 200
        );

        listaVagaDTO listarVagas(
            in long id_parque
        );

        long numeroTotalVagas(
            in long id_parque  //Numero total de vagas num determinado parque
        );


        listaVagaDTO listarVagasDisponiveis(
            in long id_parque
        );


    };

    interface Viatura{

        // ==========================
        // VIATURAS
        // ==========================

        void adicionarViatura(
            in string marca,
            in string modelo,
            in string matricula,
            in long id_usuario
        );


        listaViaturaDTO listarViaturas(
            in long id_usuario
        );


        void removerViatura(
            in long id_viatura
        );

    };   


    interface Reserva{

        // ==========================
        // RESERVAS
        // ==========================

        void criarReserva(
            in string data_entrada,
            in string hora_entrada,
            in string data_saida,
            in string hora_saida,
            in long id_vaga,
            in long id_usuario,
            in long id_viatura

        );


        ReservaDTO obterReserva(
            in long id_reserva
        );


        listaReservaDTO listarReservas(
            in long id_usuario
        );


        void cancelarReserva(
            in long id_reserva
        );

    };



};